<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kabuto.cloud.dao.system.SysUserMapper">

    <!-- 结果映射：用户 + 角色 -->
    <resultMap id="UserWithRolesAndPermissionsMap" type="com.kabuto.cloud.entity.system.SysUser">
        <id column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="birthday" property="birthday"/>
        <result column="age" property="age"/>
        <result column="sex" property="sex"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="status" property="status"/>
        <result column="login_ip" property="loginIp"/>
        <result column="login_date" property="loginDate"/>
        <!-- 角色列表 -->
        <collection property="roles" ofType="com.kabuto.cloud.entity.system.SysRole">
            <id column="role_id" property="roleId"/>
            <result column="role_name" property="name"/>
            <result column="role_key" property="roleKey"/>
            <result column="role_sort" property="sort"/>
            <result column="role_is_admin" property="isAdmin"/>
            <result column="role_status" property="status"/>
            <result column="role_description" property="description"/>
        </collection>
    </resultMap>

    <!-- 根据用户名查询用户（含角色） -->
    <select id="selectUserWithRolesAndPermissions" resultMap="UserWithRolesAndPermissionsMap">
        SELECT
            u.*,
            r.role_id,
            r.name AS role_name,
            r.role_key,
            r.sort AS role_sort,
            r.is_admin AS role_is_admin,
            r.status AS role_status,
            r.description AS role_description
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON u.user_id = ur.user_id
        LEFT JOIN sys_role r ON ur.role_id = r.role_id AND r.status = 1 AND r.deleted = 0
        WHERE u.username = #{username}
          AND u.status = 1
          AND u.deleted = 0
    </select>

    <!-- 根据用户ID查询用户（含角色） -->
    <select id="selectUserWithRolesAndPermissionsById" resultMap="UserWithRolesAndPermissionsMap">
        SELECT
            u.*,
            r.role_id,
            r.name AS role_name,
            r.role_key,
            r.sort AS role_sort,
            r.is_admin AS role_is_admin,
            r.status AS role_status,
            r.description AS role_description
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON u.user_id = ur.user_id
        LEFT JOIN sys_role r ON ur.role_id = r.role_id AND r.status = 1 AND r.deleted = 0
        WHERE u.user_id = #{userId}
          AND u.status = 1
          AND u.deleted = 0
    </select>

</mapper>
